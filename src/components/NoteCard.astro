---
import Tag from './Tag.astro';
import TechnicalDiagram from './TechnicalDiagram.astro';

type DiagramVisual =
  | 'architecture-flow'
  | 'transformer-stack'
  | 'control-bandwidth'
  | 'zvs-orbit';

interface Props {
  href: string;
  title: string;
  description: string;
  category: string;
  type: string;
  date: Date | string;
  tags: string[];
  visual: DiagramVisual;
  size: 'wide' | 'narrow';
  placeholder?: boolean;
}

const {
  href,
  title,
  description,
  category,
  type,
  date,
  tags = [],
  visual,
  size,
  placeholder = false,
} = Astro.props;

const trimmedHref = href.trim();
const isNavigable = Boolean(
  trimmedHref &&
  trimmedHref !== '#' &&
  !trimmedHref.toLowerCase().startsWith('javascript:'),
);
const CardElement = isNavigable ? 'a' : 'article';
const rawDate = date instanceof Date ? date.toISOString().slice(0, 10) : date;
const dateParts = /^(\d{4})-(\d{2})-(\d{2})/.exec(rawDate);
const dateLabel = dateParts ? `${dateParts[1]}.${dateParts[2]}.${dateParts[3]}` : rawDate;
---

<CardElement
  class:list={['note-card', size, { placeholder }]}
  href={isNavigable ? trimmedHref : undefined}
  aria-label={isNavigable ? `${placeholder ? 'Open placeholder note' : 'Read note'}: ${title}` : undefined}
>
  <div class="visual">
    <TechnicalDiagram visual={visual} />
  </div>

  <div class="content">
    <div class="kicker">
      <span>{category} · {type}</span>
      <b aria-hidden="true"></b>
    </div>

    <h3>{title}</h3>
    <p class="description">{description}</p>

    <div class="card-meta">
      <time datetime={rawDate}>{dateLabel}</time>
      {
        placeholder && (
          <span class="placeholder-flag">Placeholder</span>
        )
      }
      {
        tags.length > 0 && (
          <div class="tags" aria-label="Tags">
            {tags.map((tag) => <Tag label={tag} />)}
          </div>
        )
      }
    </div>

    {isNavigable && <span class="arrow" aria-hidden="true">↗</span>}
  </div>
</CardElement>

<style>
  .note-card {
    position: relative;
    min-height: 410px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
    backdrop-filter: blur(14px);
    transform-style: preserve-3d;
    transition:
      transform var(--duration-base) var(--ease-out),
      border-color 350ms ease,
      box-shadow 350ms ease;
  }

  a.note-card:hover {
    transform: translateY(-3px);
    border-color: rgb(60 76 99 / 0.3);
    box-shadow: var(--shadow-float);
  }

  .wide {
    grid-column: span 7;
  }

  .narrow {
    grid-column: span 5;
  }

  .visual {
    position: relative;
    height: 205px;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    background:
      radial-gradient(circle at 68% 24%, rgb(123 139 170 / 0.15), transparent 34%),
      linear-gradient(135deg, rgb(255 255 255 / 0.45), rgb(223 229 229 / 0.35));
    transform: translateZ(14px);
  }

  .visual::before {
    position: absolute;
    z-index: 0;
    inset: 0;
    background-image:
      linear-gradient(rgb(64 78 99 / 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgb(64 78 99 / 0.045) 1px, transparent 1px);
    background-size: 24px 24px;
    content: '';
    pointer-events: none;
  }

  .visual :global(svg) {
    position: relative;
    z-index: 1;
  }

  .content {
    position: relative;
    min-height: 204px;
    padding: 24px 64px 27px 25px;
    transform: translateZ(20px);
  }

  .kicker {
    display: flex;
    gap: 12px;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
    color: var(--ink-faint);
    font-size: 9px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .kicker b {
    width: 5px;
    height: 5px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--blue);
    box-shadow: 0 0 0 5px rgb(105 127 156 / 0.08);
  }

  .placeholder .kicker b {
    background: var(--violet);
  }

  h3 {
    max-width: 560px;
    margin: 0;
    font-size: var(--text-card-title);
    font-weight: 535;
    letter-spacing: -0.035em;
    line-height: 1.15;
    text-wrap: balance;
  }

  .description {
    max-width: 520px;
    margin: 13px 0 0;
    color: var(--ink-soft);
    font-size: 13px;
    line-height: 1.6;
  }

  .card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    align-items: center;
    margin-top: 20px;
  }

  time,
  .placeholder-flag {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .placeholder-flag {
    padding-left: 9px;
    border-left: 1px solid var(--line-strong);
    color: var(--violet);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    width: 100%;
  }

  .arrow {
    position: absolute;
    right: 22px;
    bottom: 22px;
    display: grid;
    width: 35px;
    height: 35px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: rgb(255 255 255 / 0.3);
    font-size: 15px;
    line-height: 1;
    place-items: center;
    transition:
      transform var(--duration-base) ease,
      background var(--duration-base) ease;
  }

  a.note-card:hover .arrow {
    transform: translate(3px, -3px);
    background: rgb(255 255 255 / 0.65);
  }

  @media (max-width: 980px) {
    .wide,
    .narrow {
      grid-column: span 6;
    }
  }

  @media (max-width: 720px) {
    .note-card,
    .wide,
    .narrow {
      grid-column: 1 / -1;
    }

    .note-card {
      min-height: 390px;
    }

    .visual {
      height: 190px;
    }

    .content {
      min-height: 199px;
      padding: 22px 58px 25px 22px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .note-card,
    .arrow {
      transition: none;
    }

    a.note-card:hover,
    a.note-card:hover .arrow {
      transform: none;
    }
  }
</style>
