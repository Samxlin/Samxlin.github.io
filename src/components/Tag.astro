---
interface Props {
  label?: string;
  href?: string;
  active?: boolean;
  ariaLabel?: string;
  class?: string;
}

const {
  label,
  href,
  active = false,
  ariaLabel,
  class: className,
} = Astro.props;

const trimmedHref = href?.trim();
const isLink = Boolean(
  trimmedHref &&
  trimmedHref !== '#' &&
  !trimmedHref.toLowerCase().startsWith('javascript:'),
);
---

{
  isLink ? (
    <a
      class:list={['tag', 'tag-link', className]}
      href={trimmedHref}
      aria-label={ariaLabel}
      aria-current={active ? 'true' : undefined}
    >
      {label ?? <slot />}
    </a>
  ) : (
    <span class:list={['tag', className, { active }]} aria-label={ariaLabel}>
      {label ?? <slot />}
    </span>
  )
}

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    min-height: 29px;
    padding-inline: 11px;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    color: var(--ink-soft);
    background: rgb(255 255 255 / 0.28);
    font-size: 10px;
    letter-spacing: 0.07em;
    line-height: 1.2;
    text-transform: uppercase;
    white-space: nowrap;
    transition:
      color var(--duration-fast) ease,
      border-color var(--duration-base) ease,
      background var(--duration-base) ease;
  }

  .tag-link:hover,
  .tag-link[aria-current='true'],
  .tag.active {
    border-color: var(--line-strong);
    color: var(--ink);
    background: rgb(255 255 255 / 0.7);
  }
</style>
