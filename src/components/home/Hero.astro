---
import ParticleField from './ParticleField.astro';
import { profile } from '../../data/profile';
---

<section class="hero page-shell" id="top">
  <div class="hero-copy">
    <p class="hero-eyebrow reveal in-view">
      <span>{profile.displayName} · {profile.headline}</span><i aria-hidden="true"></i>
    </p>
    <h1 class="reveal in-view">
      Engineering<br />the <span class="serif">invisible</span><br /><span class="thin">fields.</span>
    </h1>
    <p class="hero-lede reveal in-view">
      I explore <strong>high-frequency power conversion</strong>, magnetic structures,
      switching behavior, and digital control—turning invisible electromagnetic behavior
      into efficient, repeatable engineering.
    </p>
    <p class="hero-zh reveal in-view" lang="zh-CN">在功率、磁场与控制之间，寻找更高效、更优雅的结构。</p>

    <div class="hero-actions reveal in-view">
      <a class="button primary" href="/notes/">Explore technical notes <span aria-hidden="true">→</span></a>
      <a class="button" href="/publications/">Selected publications</a>
      <a class="about-link" href="/about/">About <span aria-hidden="true">↗</span></a>
    </div>

    <div class="hero-meta reveal in-view">
      <div><span>Focus</span><code>HF conversion / magnetics</code></div>
      <div><span>Mode</span><code>research × engineering</code></div>
      <div><span>Notebook</span><code>field log // 01</code></div>
    </div>
  </div>

  <ParticleField />
  <div class="scroll-cue">Scroll to enter the notebook</div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(360px, 0.95fr);
    gap: clamp(32px, 7vw, 110px);
    align-items: center;
    min-height: calc(100svh - var(--header-h));
    padding: clamp(54px, 8vh, 100px) 0 72px;
  }

  .hero-copy {
    position: relative;
    z-index: 2;
    max-width: 720px;
  }

  .hero-eyebrow {
    display: inline-flex;
    gap: 11px;
    align-items: center;
    margin: 0 0 24px;
    color: var(--ink-micro);
    font-size: 10px;
    font-weight: 650;
    letter-spacing: 0.17em;
    text-transform: uppercase;
  }

  .hero-eyebrow::before {
    width: 34px;
    height: 1px;
    background: var(--line-strong);
    content: "";
  }

  .hero-eyebrow i {
    position: relative;
    width: 5px;
    height: 5px;
    margin-left: 2px;
    border-radius: 50%;
    background: var(--teal);
  }

  .hero-eyebrow i::after {
    position: absolute;
    inset: -5px;
    border: 1px solid rgb(118 152 151 / 0.46);
    border-radius: 50%;
    animation: ping 2.4s ease-out infinite;
    content: "";
  }

  @keyframes ping {
    0% { transform: scale(0.5); opacity: 0; }
    20% { opacity: 1; }
    75%, 100% { transform: scale(1.45); opacity: 0; }
  }

  h1 {
    max-width: 820px;
    margin: 0;
    font-size: var(--text-hero);
    font-weight: 560;
    letter-spacing: -0.065em;
    line-height: 0.91;
    text-wrap: balance;
  }

  h1 .thin {
    color: var(--ink-soft);
    font-weight: 310;
  }

  .hero-lede {
    max-width: 610px;
    margin: 28px 0 0;
    color: var(--ink-soft);
    font-size: clamp(17px, 1.5vw, 20px);
    line-height: 1.72;
  }

  .hero-lede strong {
    color: var(--ink);
    font-weight: 580;
  }

  .hero-zh {
    margin: 9px 0 0;
    color: var(--ink-micro);
    font-size: 14px;
    letter-spacing: 0.04em;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    margin-top: 34px;
  }

  .about-link {
    padding: 12px 6px;
    color: var(--ink-soft);
    font-size: 13px;
    font-weight: 580;
  }

  .about-link:hover {
    color: var(--ink);
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 18px 28px;
    max-width: 610px;
    margin-top: 44px;
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }

  .hero-meta > div {
    display: grid;
    gap: 2px;
  }

  .hero-meta span {
    color: var(--ink-micro);
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .hero-meta code {
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .scroll-cue {
    position: absolute;
    bottom: 20px;
    left: 0;
    display: flex;
    gap: 10px;
    align-items: center;
    color: var(--ink-micro);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .scroll-cue::before {
    width: 42px;
    height: 1px;
    transform-origin: left;
    background: var(--line-strong);
    animation: breathe 2.1s ease-in-out infinite;
    content: "";
  }

  @keyframes breathe {
    50% { transform: scaleX(0.55); opacity: 0.45; }
  }

  @media (max-width: 980px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: auto;
      padding-top: 76px;
    }

    .hero-copy {
      max-width: 820px;
    }

    .scroll-cue {
      display: none;
    }
  }

  @media (max-width: 720px) {
    .hero {
      padding-top: 46px;
    }

    h1 {
      font-size: clamp(48px, 16vw, 78px);
    }

    .hero-lede {
      font-size: 16px;
    }

    .hero-meta {
      gap: 16px 22px;
    }
  }
</style>
