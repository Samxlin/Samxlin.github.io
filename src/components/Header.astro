---
import { profile } from '../data/profile';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
const navigation = [
  { href: '/about/', label: 'About', index: '01' },
  { href: '/notes/', label: 'Technical Notes', index: '02' },
  { href: '/publications/', label: 'Publications', index: '03' },
  { href: '/contact/', label: 'Contact', index: '04' },
];

const isActive = (href: string) =>
  href === '/notes/' ? currentPath.startsWith('/notes/') : currentPath === href;
---

<header class="site-header" data-site-header>
  <div class="header-inner">
    <a class="brand" href="/" aria-label={`${profile.name} home`}>
      <span class="brand-mark" aria-hidden="true"><i></i></span>
      <span>{profile.name}</span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      {
        navigation.map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <button
        class="round-button ambient-toggle"
        type="button"
        aria-label="Toggle ambient tone"
        aria-pressed="false"
        data-ambient-toggle
      >
        <span aria-hidden="true">☼</span>
      </button>
      <button
        class="round-button menu-button"
        type="button"
        aria-label="Open navigation"
        aria-expanded="false"
        aria-controls="mobile-navigation"
        data-menu-button
      >
        <span aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<nav
  class="mobile-panel"
  id="mobile-navigation"
  aria-label="Mobile navigation"
  aria-hidden="true"
  data-mobile-panel
  inert
>
  {
    navigation.map((item) => (
      <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
        <span>{item.label}</span>
        <span aria-hidden="true">{item.index}</span>
      </a>
    ))
  }
</nav>

<style>
  .site-header {
    position: sticky;
    z-index: 50;
    top: 0;
    display: flex;
    align-items: center;
    height: var(--header-h);
    border-bottom: 1px solid transparent;
    transition:
      background 350ms ease,
      border-color 350ms ease,
      backdrop-filter 350ms ease;
  }

  .site-header.scrolled {
    border-color: var(--line);
    background: rgb(244 246 243 / 0.76);
    backdrop-filter: blur(18px) saturate(125%);
  }

  .header-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 22px;
    align-items: center;
    width: var(--page);
    margin-inline: auto;
  }

  .brand {
    display: inline-flex;
    gap: 11px;
    align-items: center;
    width: max-content;
    font-size: 12px;
    font-weight: 650;
    letter-spacing: 0.16em;
    line-height: 1;
    text-transform: uppercase;
  }

  .brand-mark {
    position: relative;
    display: grid;
    width: 27px;
    height: 27px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: rgb(255 255 255 / 0.34);
    box-shadow: inset 0 0 0 5px rgb(255 255 255 / 0.18);
    place-items: center;
  }

  .brand-mark::before,
  .brand-mark::after {
    position: absolute;
    border: 1px solid rgb(87 99 126 / 0.34);
    border-radius: 50%;
    content: "";
    transform: rotate(28deg);
  }

  .brand-mark::before {
    width: 15px;
    height: 7px;
  }

  .brand-mark::after {
    width: 7px;
    height: 15px;
  }

  .brand-mark i {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--ink);
    box-shadow: 0 0 13px rgb(70 88 120 / 0.55);
  }

  .desktop-nav {
    display: flex;
    gap: clamp(18px, 3vw, 38px);
    align-items: center;
    justify-content: center;
    color: var(--ink-soft);
    font-size: 12px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .desktop-nav a {
    position: relative;
    padding-block: 11px;
    transition: color var(--duration-base) ease;
  }

  .desktop-nav a::after {
    position: absolute;
    right: 0;
    bottom: 5px;
    left: 0;
    height: 1px;
    transform: scaleX(0);
    transform-origin: right;
    background: currentColor;
    content: "";
    transition: transform var(--duration-base) ease;
  }

  .desktop-nav a:hover,
  .desktop-nav a[aria-current="page"] {
    color: var(--ink);
  }

  .desktop-nav a:hover::after,
  .desktop-nav a[aria-current="page"]::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .header-actions {
    display: flex;
    gap: 9px;
    align-items: center;
    justify-content: flex-end;
  }

  .round-button {
    display: inline-grid;
    min-width: 38px;
    height: 38px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: rgb(255 255 255 / 0.36);
    cursor: pointer;
    place-items: center;
    transition:
      transform var(--duration-base) ease,
      border-color var(--duration-base) ease,
      background var(--duration-base) ease;
  }

  .round-button:hover {
    transform: translateY(-2px);
    border-color: var(--line-strong);
    background: rgb(255 255 255 / 0.66);
  }

  .ambient-toggle span {
    font-size: 17px;
    line-height: 1;
  }

  .menu-button {
    display: none;
  }

  .menu-button span,
  .menu-button span::after {
    width: 15px;
    height: 1px;
    background: currentColor;
    content: "";
    transition: transform var(--duration-base) ease;
  }

  .menu-button span::after {
    display: block;
    transform: translateY(6px);
  }

  .menu-button[aria-expanded="true"] span {
    transform: translateY(3px) rotate(45deg);
  }

  .menu-button[aria-expanded="true"] span::after {
    transform: rotate(-90deg);
  }

  .mobile-panel {
    position: fixed;
    z-index: 49;
    top: calc(var(--header-h) - 1px);
    right: 16px;
    left: 16px;
    padding: 14px;
    transform: translateY(-12px) scale(0.98);
    border: 1px solid var(--line);
    border-radius: 18px;
    background: rgb(244 246 243 / 0.94);
    box-shadow: var(--shadow-float);
    opacity: 0;
    pointer-events: none;
    backdrop-filter: blur(20px);
    transition:
      opacity var(--duration-base) ease,
      transform var(--duration-base) ease;
  }

  .mobile-panel.open {
    transform: none;
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-panel a {
    display: flex;
    justify-content: space-between;
    padding: 12px 10px;
    border-bottom: 1px solid var(--line);
    color: var(--ink-soft);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .mobile-panel a:last-child {
    border-bottom: 0;
  }

  .mobile-panel a[aria-current="page"] {
    color: var(--ink);
  }

  @media (max-width: 980px) {
    .header-inner {
      grid-template-columns: 1fr auto;
    }

    .desktop-nav {
      display: none;
    }

    .menu-button {
      display: inline-grid;
    }
  }

  @media (max-width: 720px) {
    .brand > span:last-child,
    .ambient-toggle {
      display: none;
    }
  }
</style>
