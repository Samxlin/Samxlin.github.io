---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profileLinks } from '../data/profile';

const isExternal = (href: string) => /^https?:\/\//.test(href);
const confirmedCount = profileLinks.filter((link) => Boolean(link.href)).length;
---

<BaseLayout title="Contact" description="Contact and verified public profiles for Sam X. Lin.">
  <header class="page-shell page-intro">
    <div class="section-index">04 · Contact</div>
    <div>
      <h1 class="page-title">Let the next idea find a <span class="serif">resonant path.</span></h1>
      <p class="page-lede">
        For thoughtful engineering discussion. Only confirmed public channels are active; all
        others remain clearly marked as not supplied.
      </p>
    </div>
  </header>

  <section class="section contact-section" aria-labelledby="contact-heading">
    <div class="page-shell">
      <div class="contact-card">
        <span class="field-orbit" aria-hidden="true"><i></i></span>

        <div class="contact-copy">
          <div class="status-line"><i></i> Channel status</div>
          <h2 id="contact-heading">Open a technical <em>conversation.</em></h2>
          <p>
            Research collaboration and engineering conversations are welcome through the verified
            profiles below. Company-confidential implementation details remain outside this public
            notebook.
          </p>

          <dl class="contact-readout" aria-label="Contact channel status">
            <div><dt>Confirmed</dt><dd>{String(confirmedCount).padStart(2, '0')}</dd></div>
            <div><dt>Listed</dt><dd>{String(profileLinks.length).padStart(2, '0')}</dd></div>
          </dl>
        </div>

        <div class="contact-links" aria-label="Contact channels">
          {
            profileLinks.map((link) =>
              link.href ? (
                <a
                  class="contact-row"
                  href={link.href}
                  target={isExternal(link.href) ? '_blank' : undefined}
                  rel={isExternal(link.href) ? 'me noopener noreferrer' : undefined}
                >
                  <span>{link.label}</span>
                  <span class="row-value">
                    {link.value} <span aria-hidden="true">↗</span>
                  </span>
                </a>
              ) : (
                <div class="contact-row is-pending">
                  <span>{link.label}</span>
                  <span class="row-value">
                    <span>Not supplied</span>
                    <small>Pending</small>
                  </span>
                </div>
              ),
            )
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(320px, 0.92fr);
    gap: clamp(48px, 7vw, 92px);
    align-items: end;
    min-height: 520px;
    padding: clamp(38px, 7vw, 82px);
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-contact);
    background:
      radial-gradient(circle at 84% 18%, rgb(121 137 165 / 0.18), transparent 26rem),
      linear-gradient(135deg, rgb(249 250 247 / 0.82), rgb(228 234 232 / 0.62));
    box-shadow: 0 30px 100px rgb(45 59 79 / 0.08);
  }

  .contact-card::before {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(55 71 91 / 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgb(55 71 91 / 0.045) 1px, transparent 1px);
    background-size: 30px 30px;
    content: "";
    mask-image: radial-gradient(circle at 76% 28%, black, transparent 68%);
    pointer-events: none;
  }

  .contact-copy,
  .contact-links {
    position: relative;
    z-index: 1;
  }

  .status-line {
    display: inline-flex;
    gap: 9px;
    align-items: center;
    margin-bottom: 30px;
    color: var(--ink-micro);
    font-size: 9px;
    font-weight: 650;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .status-line i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--teal);
    box-shadow: 0 0 0 4px rgb(118 152 151 / 0.1), 0 0 18px rgb(118 152 151 / 0.44);
  }

  .contact-copy h2 {
    max-width: 680px;
    margin: 0 0 22px;
    font-size: clamp(42px, 5.8vw, 76px);
    font-weight: 470;
    letter-spacing: -0.055em;
    line-height: 0.98;
    text-wrap: balance;
  }

  .contact-copy h2 em {
    color: var(--violet);
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
  }

  .contact-copy > p {
    max-width: 620px;
    margin: 0;
    color: var(--ink-soft);
    font-size: 15px;
  }

  .contact-readout {
    display: flex;
    gap: 30px;
    margin: 42px 0 0;
  }

  .contact-readout > div {
    min-width: 88px;
    padding-top: 10px;
    border-top: 1px solid var(--line-strong);
  }

  .contact-readout dt {
    color: var(--ink-faint);
    font-size: 8px;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .contact-readout dd {
    margin: 4px 0 0;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .contact-links {
    display: grid;
    align-content: end;
    border-top: 1px solid var(--line-strong);
  }

  .contact-row {
    display: flex;
    gap: 18px;
    align-items: center;
    justify-content: space-between;
    min-width: 0;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink-soft);
    font-size: 13px;
  }

  a.contact-row {
    transition: padding-left var(--duration-base) ease, color var(--duration-base) ease;
  }

  a.contact-row:hover {
    padding-left: 8px;
    color: var(--ink);
  }

  .row-value {
    display: inline-flex;
    gap: 7px;
    align-items: center;
    justify-content: flex-end;
    min-width: 0;
    color: var(--ink-micro);
    text-align: right;
  }

  .is-pending {
    cursor: default;
  }

  .is-pending .row-value {
    color: var(--ink-faint);
  }

  .row-value small {
    display: inline-flex;
    align-items: center;
    min-height: 20px;
    padding-inline: 7px;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    color: var(--ink-micro);
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .field-orbit {
    position: absolute;
    top: -94px;
    right: -20px;
    width: 360px;
    height: 360px;
    border: 1px solid rgb(91 105 135 / 0.13);
    border-radius: 50%;
    box-shadow:
      0 0 0 38px rgb(91 105 135 / 0.025),
      0 0 0 86px rgb(91 105 135 / 0.018);
    pointer-events: none;
  }

  .field-orbit::before,
  .field-orbit::after {
    position: absolute;
    top: 50%;
    left: 50%;
    content: "";
  }

  .field-orbit::before {
    width: 118%;
    height: 1px;
    transform: translate(-50%, -50%) rotate(-31deg);
    background: linear-gradient(90deg, transparent, rgb(93 107 136 / 0.18), transparent);
  }

  .field-orbit::after {
    width: 7px;
    height: 7px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: var(--blue);
    box-shadow: 0 0 18px rgb(105 127 156 / 0.42);
  }

  .field-orbit i {
    position: absolute;
    inset: 23%;
    transform: rotate(32deg) scaleY(0.42);
    border: 1px solid rgb(91 105 135 / 0.16);
    border-radius: 50%;
  }

  @media (max-width: 920px) {
    .contact-card {
      grid-template-columns: 1fr;
      gap: 56px;
    }
  }

  @media (max-width: 720px) {
    .contact-card {
      min-height: 0;
      padding: 34px 25px;
      border-radius: 24px;
    }

    .field-orbit {
      top: -165px;
      right: -155px;
    }
  }

  @media (max-width: 430px) {
    .contact-row {
      gap: 10px;
      align-items: flex-start;
    }

    .row-value {
      flex-wrap: wrap;
      max-width: 65%;
    }
  }
</style>
