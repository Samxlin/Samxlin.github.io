---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import Tag from '../components/Tag.astro';
import '../styles/technical.css';

type NoteEntry = CollectionEntry<'notes'>;

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  note: NoteEntry;
  headings: Heading[];
  previous?: NoteEntry;
  next?: NoteEntry;
  related?: NoteEntry[];
}

const { note, headings, previous, next, related = [] } = Astro.props;
const { data } = note;

const slugFromId = (id: string) =>
  id
    .replace(/\.(md|mdx)$/i, '')
    .replace(/(^|\/)index$/i, '')
    .replace(/^\/+|\/+$/g, '');
const hrefFor = (entry: NoteEntry) => `/notes/${slugFromId(entry.id)}/`;
const isoDate = (date: Date) => date.toISOString().slice(0, 10);
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en', {
    year: 'numeric',
    month: 'short',
    day: '2-digit',
    timeZone: 'UTC',
  }).format(date);
---

<BaseLayout
  title={data.title}
  description={data.description}
  canonical={hrefFor(note)}
  ogImage={data.cover}
  ogType="article"
  bodyClass="note-page"
>
  <Fragment slot="head">
    <meta property="article:published_time" content={note.data.date.toISOString()} />
    {data.updated && <meta property="article:modified_time" content={data.updated.toISOString()} />}
    {data.tags.map((tag) => <meta property="article:tag" content={tag} />)}
  </Fragment>

  <header class="note-hero page-shell">
    <a class="note-back" href="/notes/"><span aria-hidden="true">←</span> Technical Notes</a>
    <div class="note-kicker">
      <span>{data.category}</span>
      <i aria-hidden="true"></i>
      <span>{data.type}</span>
      {data.series && <><i aria-hidden="true"></i><span>Series · {data.series}</span></>}
    </div>
    <h1 id="note-title">{data.title}</h1>
    <p class="note-description">{data.description}</p>

    <div class="note-meta">
      <time datetime={isoDate(data.date)}>Published {formatDate(data.date)}</time>
      {data.updated && <time datetime={isoDate(data.updated)}>Updated {formatDate(data.updated)}</time>}
      {data.authors.length > 0 && <span>By {data.authors.join(', ')}</span>}
    </div>

    {data.tags.length > 0 && <div class="note-tags" aria-label="Tags">{data.tags.map((tag) => <Tag label={tag} />)}</div>}

    {
      data.placeholder && (
        <aside class="placeholder-banner" aria-label="Editorial status">
          <span>Editorial placeholder</span>
          <p>This page demonstrates the technical-notes format. Its generalized examples are not project data, test results, or a completed engineering article.</p>
        </aside>
      )
    }
  </header>

  <div class="article-grid page-shell">
    <aside class="toc-column">
      <TableOfContents headings={headings} />
    </aside>

    <article class="technical-article" aria-labelledby="note-title">
      <slot />

      {
        data.references.length > 0 && (
          <section class="note-references" aria-labelledby="references-heading">
            <h2 id="references-heading">References</h2>
            <ol>
              {data.references.map((reference) => (
                <li>
                  {reference.url ? <a href={reference.url}>{reference.title}</a> : reference.title}
                </li>
              ))}
            </ol>
          </section>
        )
      }

      {
        (previous || next) && (
          <nav class="note-sequence" aria-label="Previous and next notes">
            {previous ? (
              <a href={hrefFor(previous)}>
                <span>Previous · newer</span>
                <strong>{previous.data.title}</strong>
              </a>
            ) : <span aria-hidden="true"></span>}
            {next && (
              <a class="next" href={hrefFor(next)}>
                <span>Next · older</span>
                <strong>{next.data.title}</strong>
              </a>
            )}
          </nav>
        )
      }

      {
        related.length > 0 && (
          <section class="related-notes" aria-labelledby="related-heading">
            <div>
              <span>Related field notes</span>
              <h2 id="related-heading">Continue through the model.</h2>
            </div>
            <ul>
              {related.map((entry) => (
                <li>
                  <a href={hrefFor(entry)}>
                    <span>{entry.data.category} · {entry.data.type}</span>
                    <strong>{entry.data.title}</strong>
                    <i aria-hidden="true">↗</i>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </article>
  </div>
</BaseLayout>
