---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  lang?: string;
  bodyClass?: string;
}

const {
  title = 'Sam X. Lin',
  description = 'A public engineering notebook on high-frequency power conversion, magnetics, digital control, and wireless power.',
  canonical,
  ogImage = '/og-luminous-field.jpg',
  ogType = 'website',
  lang = 'en',
  bodyClass,
} = Astro.props;

const fullTitle = title === 'Sam X. Lin' ? title : `${title} · Sam X. Lin`;
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, Astro.site);
const imageUrl = ogImage ? new URL(ogImage, Astro.site) : null;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.add('js');
      const revealFallback = window.setTimeout(
        () => document.documentElement.classList.add('reveal-fallback'),
        1600,
      );
      document.addEventListener(
        'luminous:reveal-ready',
        () => window.clearTimeout(revealFallback),
        { once: true },
      );
    </script>
    <meta name="theme-color" content="#f2f4f1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Sam X. Lin" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}

    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="scroll-progress" aria-hidden="true"><span data-scroll-progress></span></div>
    <Header currentPath={Astro.url.pathname} />
    <main class="site-main" id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/site-shell';
    </script>
  </body>
</html>
